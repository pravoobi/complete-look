# YouCam (India region: makeupar.com hosts)
YOUCAM_API_KEY=
YOUCAM_SECRET_KEY=
YOUCAM_API_BASE=https://yce-api-01.makeupar.com
# Stylist agent (pinned model, no "auto"; AGENT_MODEL is accepted as an alias)
ANTHROPIC_API_KEY=
STYLIST_MODEL=claude-sonnet-5-5
# Unit guards: one complete look on a new photo is 28 units
YOUCAM_SESSION_UNIT_CAP=30
YOUCAM_DAILY_UNIT_CAP=80
# Set to "off" to pause live YouCam calls; the samples keep working
LIVE_MODE=
